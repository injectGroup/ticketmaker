rules_version = '2';

// Quick Ticket Maker — Firestore security rules
// Paths used by the app:
//   users/{uid}                      — Auth profile documents
//   users/{uid}/tickets/{ticketId}   — Saved ticket metadata
//   ticketIndex/{code}               — Host-owned code index for door check-in
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /tickets/{ticketId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Door verification index: only the host who created the code may read/write.
    match /ticketIndex/{code} {
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code is string;
      allow read, update, delete: if isSignedIn()
        && resource.data.hostUid == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
