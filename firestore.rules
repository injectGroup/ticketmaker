rules_version = '2';

// Quick Ticket Maker — Firestore security rules
// Paths used by the app:
//   users/{uid}                      — Auth profile documents
//   users/{uid}/tickets/{ticketId}   — Saved ticket metadata (owner)
//   tickets/{code}                   — Public door verify docs (QR /verify/:id)
//   ticketIndex/{code}               — Legacy verify index (kept in sync)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function checkInOnlyKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['checkedIn', 'checkedInAt', 'status', 'updatedAt']);
    }

    function isPublicCheckInTransition() {
      return resource.data.get('checkedIn', false) != true
        && request.resource.data.checkedIn == true
        && request.resource.data.status == 'checked_in'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.ticketId == resource.data.ticketId
        && request.resource.data.code == resource.data.code;
    }

    function isTicketDocCheckIn() {
      return resource.data.get('checkedIn', false) != true
        && request.resource.data.checkedIn == true
        && checkInOnlyKeys();
    }

    function hostOwnsPublicTicket() {
      return isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    function hostCreatesPublicTicket() {
      return isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code is string;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /tickets/{ticketId} {
        allow read, write: if isOwner(userId);
        allow update: if isTicketDocCheckIn();
      }
    }

    // Public verification documents keyed by guest code.
    match /tickets/{code} {
      allow create: if hostCreatesPublicTicket();
      allow delete: if hostOwnsPublicTicket();
      allow read: if true;
      allow update: if hostOwnsPublicTicket()
        || (checkInOnlyKeys() && isPublicCheckInTransition());
    }

    // Legacy door verification index.
    match /ticketIndex/{code} {
      allow create: if hostCreatesPublicTicket();
      allow delete: if hostOwnsPublicTicket();
      allow read: if true;
      allow update: if hostOwnsPublicTicket()
        || (checkInOnlyKeys() && isPublicCheckInTransition());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
